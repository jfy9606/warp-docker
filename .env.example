# ── sing-box / xray multi-IP mode (.env for docker-compose.singbox.yml /
#    docker-compose.xray.yml) ─────────────────────────────────────────────
#
# Copy this file to .env and adjust the values, then run one of:
#
#   docker compose -f docker-compose.singbox.yml up -d --build
#   docker compose -f docker-compose.xray.yml up -d --build
#
# docker compose reads .env automatically from the project directory and
# substitutes the variables below into the compose file. Leave a variable
# commented out (or empty) to use its default.
#
# The official-client mode (docker-compose.yml) is NOT driven by this file;
# it keeps its own inline environment. See docs/singbox-multi-ip.md and
# docs/xray-multi-ip.md.

# ── shared (both modes) ───────────────────────────────────────────────────

# Seconds to wait after startup / rotation for the tunnels to complete their
# first handshake. Raise it on slow hosts.
# WARP_SLEEP=2

# Optional WARP+ license key, applied to each new registration. A WARP+
# account allows at most 5 linked devices, so with multiple tunnels +
# rotation it fills up fast — leave empty for free WARP (no device limit).
# WARP_LICENSE_KEY=

# Re-register ALL tunnels (new identities -> new IPs) on this interval (GNU
# sleep duration: 3600 / 30m / 6h). Leave empty to disable automatic
# rotation. All SOCKS5 ports blip briefly at each rotation.
# WARP_IP_ROTATE_INTERVAL=6h

# ── upstream SOCKS5 proxy for the WARP tunnels (optional) ──────────────────
#
# Chain the WireGuard tunnels through an upstream SOCKS5 proxy
# (WireGuard -> SOCKS5 -> Cloudflare). Supported by BOTH multi-IP modes
# (sing-box and xray); the official-client mode (docker-compose.yml) does
# NOT support it (the official client has no outbound-proxy option).
#
# Format: socks5://[user:pass@]host:port[?udp_over_tcp=true]
#
#   - WireGuard is UDP, so the proxy must relay UDP (SOCKS5 UDP ASSOCIATE).
#     The ?udp_over_tcp=true query is sing-box only and only helps when the
#     upstream proxy is itself a sing-box / mihomo-compatible SOCKS5 server
#     with udp_over_tcp enabled; plain SOCKS5 proxies ignore it.
#   - A hostname is resolved once at startup (and at each rotation) using
#     the container's DNS, outside the tunnel. If the hostname cannot be
#     resolved from the container, use an IP address instead.
#   - Registration / license / rotation API calls also go through the proxy,
#     so the container does not need direct access to api.cloudflareclient.com.
# WARP_PROXY=socks5://user:pass@proxy.example.com:1080

# Advanced / rarely needed:
# WARP_API_BASE=https://api.cloudflareclient.com/v0a4005
# WARP_CLIENT_VERSION=a-6.30-3596
# WARP_WG_PORT=2408

# ── sing-box mode (docker-compose.singbox.yml) ────────────────────────────

# Host port range of the SOCKS5 exits. The single knob that controls how
# many tunnels run: "1080-1081" = 2 exits (1080 and 1081), each with its
# own WARP tunnel and independent egress IP. The range must be contiguous;
# the compose files run in host network mode, so the container binds these
# ports directly on the host (no port mapping) — they must be free.
SINGBOX_PORTS=1080-1081

# Fallbacks used only when SINGBOX_PORTS is not set (e.g. plain `docker run`):
#   SINGBOX_TUNNELS=2          # number of tunnels
#   SINGBOX_SOCKS_PORT=1080    # base port; tunnels listen on 1080..1080+N-1

# Advanced / rarely needed:
# SING_BOX_VERSION=1.13.18           # sing-box release to build
# SINGBOX_IMAGE=warp-singbox:latest  # image tag
# SINGBOX_CONTAINER_NAME=warp-singbox
# SINGBOX_RESTART=always
# SINGBOX_DATA_DIR=./data-singbox    # host dir persisting tunnel identities

# ── xray mode (docker-compose.xray.yml) ───────────────────────────────────

# Same as SINGBOX_PORTS, for the xray mode.
XRAY_PORTS=1080-1081

# Fallbacks used only when XRAY_PORTS is not set (e.g. plain `docker run`):
#   XRAY_TUNNELS=2          # number of tunnels
#   XRAY_SOCKS_PORT=1080    # base port; tunnels listen on 1080..1080+N-1

# Advanced / rarely needed:
# XRAY_VERSION=26.3.27           # xray-core release to build (latest stable)
# XRAY_IMAGE=warp-xray:latest    # image tag
# XRAY_CONTAINER_NAME=warp-xray
# XRAY_RESTART=always
# XRAY_DATA_DIR=./data-xray      # host dir persisting tunnel identities
# WARP_WG_MTU=1280               # WireGuard MTU (official WARP client default; xray mode only)
# WARP_WG_KEEPALIVE=25           # peer keepalive, seconds (official client default; xray mode only)

# If you run both multi-IP modes at the same time, give them different port
# ranges (e.g. SINGBOX_PORTS=1080-1081 and XRAY_PORTS=1180-1181) so the
# host ports do not collide.
